                android:gradientRadius="260dp"
                android:startColor="#55246BFF"
                android:centerColor="#221B4DFF"
                android:endColor="#00040713" />
        </shape>
    </item>
    <item android:top="240dp" android:left="-120dp" android:right="160dp" android:bottom="220dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:startColor="#334CC9FF"
                android:endColor="#00040713" />
        </shape>
    </item>
    <item android:top="520dp" android:left="160dp" android:right="-120dp" android:bottom="-80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#338B5CFF"
                android:endColor="#00040713" />
        </shape>
    </item>
</layer-list>