<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#664C6CFF"
                android:centerColor="#338B5CFF"
                android:endColor="#00070812" />
        </shape>
    </item>
    <item android:bottom="40dp" android:left="40dp" android:right="40dp" android:top="40dp">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#FFB07CFF" />
            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:startColor="#00000000"
                android:centerColor="#224C6CFF"
                android:endColor="#884C6CFF" />
        </shape>
    </item>
    <item android:bottom="58dp" android:left="58dp" android:right="58dp" android:top="58dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#AA4CC9FF" />
        </shape>
    </item>
</layer-list>
