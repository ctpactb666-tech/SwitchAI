<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="26dp"
                android:startColor="#CC8B5CFF"
                android:centerColor="#664C6CFF"
                android:endColor="#00070812" />
        </shape>
    </item>
    <item android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="18dp"
                android:startColor="#FF4CC9FF"
                android:centerColor="#FF6D4DFF"
                android:endColor="#FF2A1466" />
            <stroke android:width="1.5dp" android:color="#FFC7B8FF" />
        </shape>
    </item>
</layer-list>
