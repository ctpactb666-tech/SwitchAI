<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_neon_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neon_card"
                android:orientation="vertical"
                android:padding="14dp">

                <!--phrase-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/phraseInput"
                    android:text="@string/neon_phrase_label"
                    android:textColor="@color/ai_text_secondary"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/phraseInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints=""
                        android:background="@drawable/bg_neon_input"
                        android:hint="@string/neon_phrase_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLines="3"
                        android:minHeight="50dp"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="46dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/neon_text_primary"
                        android:textColorHint="@color/neon_text_muted"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/phraseClear"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/neon_phrase_clear"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        app:tint="@color/ai_text_secondary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/phraseHelper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/neon_phrase_helper"
                    android:textColor="@color/neon_text_muted"
                    android:textSize="12sp" />

                <!--assistant-->
                <TextView
                    style="@style/SwitchAI.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/neon_choose_assistant" />

                <LinearLayout
                    android:id="@+id/assistantPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_neon_input"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <FrameLayout
                        android:id="@+id/pickerTile"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        tools:background="@drawable/bg_icon_alice">

                        <ImageView
                            android:id="@+id/pickerIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:tint="@android:color/white"
                            tools:src="@drawable/ic_assistant_alice" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pickerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/neon_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Алиса" />

                        <TextView
                            android:id="@+id/pickerVendor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ai_text_secondary"
                            android:textSize="11sp"
                            tools:text="Яндекс" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/ai_text_secondary" />
                </LinearLayout>

                <!--language-->
                <TextView
                    style="@style/SwitchAI.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/neon_language" />

                <LinearLayout
                    android:id="@+id/languagePicker"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_neon_input"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_language"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/languageName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:textColor="@color/neon_text_primary"
                        android:textSize="14sp"
                        tools:text="Автоопределение" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/ai_text_secondary" />
                </LinearLayout>

                <!--advanced-->
                <TextView
                    style="@style/SwitchAI.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/neon_advanced" />

                <include
                    android:id="@+id/rowExact"
                    layout="@layout/item_neon_switch_row" />

                <include
                    android:id="@+id/rowIgnoreMusic"
                    layout="@layout/item_neon_switch_row" />

                <include
                    android:id="@+id/rowOffline"
                    layout="@layout/item_neon_switch_row" />
            </LinearLayout>

            <TextView
                android:id="@+id/deletePhrase"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neon_danger"
                android:gravity="center"
                android:text="@string/neon_delete_phrase"
                android:textColor="@color/neon_danger"
                android:textSize="15sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/savePhrase"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_neon_primary_button"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/neon_save"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
