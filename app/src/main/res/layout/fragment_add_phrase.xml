<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_cosmic">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Добавить фразу" android:textColor="@android:color/white" android:textSize="24sp" android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Фраза для активации">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phraseInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="@android:color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Выберите ассистента" android:textColor="@android:color/white" android:textStyle="bold" />
        <Spinner
            android:id="@+id/assistantSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/preference_background_single"
            android:entries="@array/wake_phrase_assistant_names"
            android:paddingHorizontal="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Язык распознавания" android:textColor="@android:color/white" android:textStyle="bold" />
        <Spinner
            android:id="@+id/languageSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/preference_background_single"
            android:entries="@array/wake_phrase_language_names"
            android:paddingHorizontal="16dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/exactMatchSwitch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="Точное совпадение"
            android:textColor="@android:color/white" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/offlineSwitch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Работать в офлайн режиме"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/savePhrase"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="26dp"
            android:text="Сохранить"
            android:textSize="16sp"
            app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
