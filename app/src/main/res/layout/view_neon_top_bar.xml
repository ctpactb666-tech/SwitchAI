<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="16dp">

    <ImageButton
        android:id="@+id/topBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/neon_back"
        android:src="@drawable/ic_back"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/topTitle"
        style="@style/SwitchAI.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        tools:text="Голосовая активация" />

    <ImageButton
        android:id="@+id/topExtra"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_neon_square_button"
        android:contentDescription="@string/neon_phrases_add"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:tint="@android:color/white"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/topAction"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_neon_round_button"
        android:contentDescription="@string/neon_listen"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_wave_bars"
        app:tint="@android:color/white" />
</LinearLayout>
