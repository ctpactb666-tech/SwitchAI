<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_commands"
                app:tint="@color/neon_violet" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SwitchAI.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/neon_commands_title" />

                <TextView
                    style="@style/SwitchAI.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/neon_commands_subtitle" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/commandsListen"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_neon_round_button"
                android:contentDescription="@string/neon_listen"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wave_bars"
                app:tint="@android:color/white" />
        </LinearLayout>

        <include
            android:id="@+id/openActivation"
            layout="@layout/item_neon_nav_row" />

        <include
            android:id="@+id/openPhrases"
            layout="@layout/item_neon_nav_row" />

        <include
            android:id="@+id/openOwnerVoice"
            layout="@layout/item_neon_nav_row" />

        <include
            android:id="@+id/openTest"
            layout="@layout/item_neon_nav_row" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
