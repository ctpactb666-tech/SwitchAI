<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:id="@+id/pickerTile"
        android:layout_width="38dp"
        android:layout_height="38dp"
        tools:background="@drawable/bg_icon_alice">

        <ImageView
            android:id="@+id/pickerIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@android:color/white"
            tools:src="@drawable/ic_assistant_alice" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pickerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/neon_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Алиса" />

        <TextView
            android:id="@+id/pickerVendor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ai_text_secondary"
            android:textSize="12sp"
            tools:text="Яндекс" />
    </LinearLayout>
</LinearLayout>
