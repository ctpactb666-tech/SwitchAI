<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_neon_card"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/assistantTile"
        android:layout_width="52dp"
        android:layout_height="52dp"
        tools:background="@drawable/bg_icon_chatgpt">

        <ImageView
            android:id="@+id/assistantIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@android:color/white"
            tools:src="@drawable/ic_assistant_chatgpt" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/assistantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/neon_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="ChatGPT" />

        <TextView
            android:id="@+id/assistantVendor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ai_text_secondary"
            android:textSize="12sp"
            tools:text="OpenAI" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/assistantStatusIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/neon_teal" />

            <TextView
                android:id="@+id/assistantStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/neon_teal"
                android:textSize="11sp"
                tools:text="Установлен" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/assistantQuickLaunch"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_neon_round_button_dim"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic"
        app:tint="@android:color/white"
        tools:ignore="ContentDescription" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/ai_text_secondary" />
</LinearLayout>
