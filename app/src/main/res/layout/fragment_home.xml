<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp">

        <!--header: logo, title, mic-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_logo_orb">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SwitchAI.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="24sp" />

                <TextView
                    style="@style/SwitchAI.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/neon_home_subtitle" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/homeHeaderListen"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_neon_round_button"
                android:contentDescription="@string/neon_listen"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!--big orb-->
        <FrameLayout
            android:id="@+id/homeOrbContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/neon_listen"
            android:focusable="true"
            android:clickable="true">

            <View
                android:id="@+id/homeOrb"
                android:layout_width="236dp"
                android:layout_height="236dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orb_complex" />

            <ImageView
                android:id="@+id/homeWave"
                android:layout_width="280dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_voice_wave_neon" />
        </FrameLayout>

        <!--status row with side buttons-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/homeToggle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_neon_round_button"
                android:contentDescription="@string/neon_home_toggle"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/homeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/neon_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Ожидание фразы…" />

                <TextView
                    android:id="@+id/homePhrase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/ai_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    tools:text="«Слушай, Джарвис»" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/homePhrases"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.75"
                android:background="@drawable/bg_neon_round_button_dim"
                android:contentDescription="@string/neon_home_phrases"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@color/ai_text_secondary" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/homeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:useDefaultMargins="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
