<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_cosmic"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SwitchAI"
                    android:textColor="@android:color/white"
                    android:textSize="31sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Ваш единый центр AI-ассистентов"
                    android:textColor="#AEB9D8"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/openVoiceActivation"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_mic_button_neon"
                android:padding="17dp"
                android:src="@drawable/ic_voice_input"
                app:tint="@android:color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_marginTop="12dp">

            <View
                android:layout_width="292dp"
                android:layout_height="292dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orb_complex" />

            <View
                android:layout_width="232dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:background="@color/neon_blue"
                android:alpha="0.55" />

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_button_neon"
                android:padding="24dp"
                android:src="@drawable/ic_voice_input"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/listeningStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Ожидание фразы..."
            android:textColor="@android:color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/listeningPhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="«Слушай, Джарвис»"
            android:textColor="#A9B8E0"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ассистенты"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/assistantGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="3"
            android:rowCount="2">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChatGpt"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_assistant_card_blue" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                    <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_icon_chatgpt">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:src="@drawable/ic_assistant_chatgpt" app:tint="@android:color/white"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="ChatGPT" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGemini"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_assistant_card_blue" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                    <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_icon_gemini">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:src="@drawable/ic_assistant_gemini" app:tint="@android:color/white"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Gemini" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardClaude"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_assistant_card_orange" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                    <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_icon_claude">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:src="@drawable/ic_assistant_claude" app:tint="@android:color/white"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Claude" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlice"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_assistant_card_purple" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                    <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_icon_alice">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:src="@drawable/ic_assistant_alice" app:tint="@android:color/white"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Алиса" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCopilot"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_assistant_card_blue" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                    <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_icon_copilot">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:src="@drawable/ic_assistant_copilot" app:tint="@android:color/white"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Copilot" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGrok"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_assistant_card_purple" android:gravity="center" android:orientation="vertical" android:padding="12dp">
                    <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_icon_grok">
                        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:src="@drawable/ic_assistant_grok" app:tint="@android:color/white"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Grok" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>