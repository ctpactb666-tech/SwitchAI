<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_neon_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!--main switch-->
            <LinearLayout
                android:id="@+id/activationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neon_card_glow"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/neon_activation_enable"
                        android:textColor="@color/neon_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/neon_activation_enable_summary"
                        android:textColor="@color/ai_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/activationSwitch"
                    style="@style/SwitchAI.Switch.Blue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!--status-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neon_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/neon_status"
                        android:textColor="@color/neon_blue"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/statusIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_neon_status_icon"
                            android:importantForAccessibility="no"
                            android:padding="5dp"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/neon_teal" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/neon_teal"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Активно" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/statusWave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_voice_wave_neon" />
            </LinearLayout>

            <!--sensitivity-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neon_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/neon_sensitivity"
                        android:textColor="@color/neon_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sensitivityLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ai_text_secondary"
                        android:textSize="13sp"
                        tools:text="Средняя" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sensitivitySlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/neon_sensitivity"
                    android:stepSize="0.05"
                    android:value="0.5"
                    android:valueFrom="0"
                    android:valueTo="1"
                    app:haloColor="#338B7CFF"
                    app:labelBehavior="gone"
                    app:thumbColor="@android:color/white"
                    app:tickVisible="false"
                    app:trackColorActive="#5B7CFF"
                    app:trackColorInactive="@color/neon_track_off" />
            </LinearLayout>

            <!--behaviour switches-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_neon_card"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <include
                    android:id="@+id/rowLocked"
                    layout="@layout/item_neon_switch_row" />

                <include
                    android:id="@+id/rowBluetooth"
                    layout="@layout/item_neon_switch_row" />

                <include
                    android:id="@+id/rowSound"
                    layout="@layout/item_neon_switch_row" />

                <include
                    android:id="@+id/rowVibration"
                    layout="@layout/item_neon_switch_row" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
