<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_cosmic">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Голосовая активация"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#E80B1324"
            app:cardCornerRadius="20dp"
            app:strokeColor="#404CC9FF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Включить голосовую активацию" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Приложение будет слушать заданные фразы" android:textColor="@color/ai_text_secondary" android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/activationSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#E80B1324"
            app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Статус" android:textColor="@color/ai_text_secondary" android:textSize="12sp" />
                    <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Неактивно" android:textColor="#36E6C2" android:textSize="18sp" android:textStyle="bold" />
                </LinearLayout>
                <ImageView android:layout_width="72dp" android:layout_height="52dp" android:src="@drawable/ic_voice_input" app:tint="@color/neon_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#E80B1324"
            app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Чувствительность" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/sensitivityLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Средняя" android:textColor="@color/ai_text_secondary" android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/sensitivitySlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="0.72"
                    android:valueFrom="0.5"
                    android:valueTo="0.95"
                    android:stepSize="0.01" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/preference_background_single"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/lockedScreenSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Работать при заблокированном экране"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bluetoothSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Запускать при Bluetooth-гарнитуре"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/soundSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Звуковое подтверждение"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/vibrationSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Вибрация при срабатывании"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
